cat > .gitignore <<'EOF'
# Environment / secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Node
node_modules/
*/node_modules/

# React builds
build/
*/build/

# Runtime/generated storage
storage_data/
*/storage_data/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log

# Coverage
.coverage
htmlcov/

# Docker overrides
docker-compose.override.yml
EOF